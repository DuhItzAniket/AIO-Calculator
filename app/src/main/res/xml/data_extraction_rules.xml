<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="aio_calculator.db" />
        <exclude domain="sharedpref" path="settings_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="aio_calculator.db" />
        <include domain="sharedpref" path="settings_preferences.xml" />
    </device-transfer>
</data-extraction-rules>